.venv/
__pycache__/
*.pyc
config.yaml
# YouTube の認証情報（OAuth クライアントとトークン）
secrets/

work/*
!work/.gitkeep
ready/*
!ready/.gitkeep
# 動画の置き場（mp4・説明文は git に入れない。経緯は stories/*/{id}.json の history）
upload/*
!upload/.gitkeep
posted/*
!posted/.gitkeep
rejected/*
!rejected/.gitkeep

*.wav
*.mp3
*.ogg
*.mp4
*.png
!assets/**/*.png

# BGM は別管理（作曲の証拠として REAPER プロジェクトと MIDI は残す）
!assets/bgm/*.mid

# ローカルに置く外部ツール（voicevox_engine など）
tools/

# 生成物・個人設定
.pytest_cache/
*.egg-info/
.claude/settings.local.json
