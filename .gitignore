.venv/
__pycache__/
*.pyc
config.yaml
# YouTube の認証情報（OAuth クライアントとトークン。channels/{name}/secrets/）
secrets/

# チャンネルごとの生成物（channels/{name}/）。動画・説明文・中間ファイルは git に入れない。経緯は stories/*/{id}.json の history
channels/*/work/*
!channels/*/work/.gitkeep
channels/*/ready/*
!channels/*/ready/.gitkeep
channels/*/upload/*
!channels/*/upload/.gitkeep
channels/*/posted/*
!channels/*/posted/.gitkeep
channels/*/rejected/*
!channels/*/rejected/.gitkeep

*.wav
*.mp3
*.ogg
*.mp4
*.png
!assets/**/*.png

# BGM は別管理（作曲の証拠として REAPER プロジェクトと MIDI は残す）
!assets/bgm/*.mid

# ローカルに置く外部ツール（voicevox_engine など）
tools/

# 生成物・個人設定
.pytest_cache/
*.egg-info/
.claude/settings.local.json

# Mixamo の動き（Adobe の規約で再配布できない。各自 mixamo.com から落とす。docs/decisions.md D-027）
assets/3d/motions/mixamo/*.fbx
